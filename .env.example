# ─────────────────────────────────────────────────────────────
# VibeChat — пример переменных окружения.
# Скопируйте в .env и заполните. Никогда не коммитьте .env в git.
# ─────────────────────────────────────────────────────────────

# development | production
NODE_ENV=development
HOST=0.0.0.0
PORT=8080

# Название сервиса (меняется без пересборки: подставляется в заголовок и интерфейс)
APP_NAME=VibeChat

# Публичный адрес сайта. В production обязателен и должен быть https://
# PUBLIC_ORIGIN=https://vibechat.example.com
PUBLIC_ORIGIN=
# Дополнительные разрешённые адреса через запятую (необязательно)
EXTRA_ORIGINS=

# Секрет для подписи cookie и хеширования IP. Минимум 32 символа.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Каталог для базы SQLite (жалобы, баны, блокировки, администраторы)
DATA_DIR=./data

# Сколько прокси стоит перед приложением (Caddy/Nginx = 1). 0 — запуск без прокси.
TRUST_PROXY=0

LOG_LEVEL=info

# ── WebRTC: STUN/TURN ─────────────────────────────────────────
# STUN по умолчанию — публичные серверы Google. Можно указать свои через запятую.
STUN_URLS=
# TURN нужен для ~10–20% пользователей (мобильные сети, корпоративные NAT).
# Пример для своего coturn: turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
TURN_URLS=
# Вариант 1 (рекомендуется, coturn): общий секрет → сервер выдаёт временные логины
TURN_SECRET=
# Вариант 2 (облачные TURN — Metered, Twilio, Xirsys): статические логин и пароль
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_TTL_SECONDS=21600
# Если свой TURN не задан, сервер использует бесплатный публичный Open Relay (metered.ca). off — выключить.
PUBLIC_TURN=on
# Cloudflare Realtime TURN (1000 ГБ/мес бесплатно): Cloudflare Dashboard → Realtime → TURN → Create key
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# relay — весь медиатрафик только через TURN: собеседники не видят IP друг друга (дороже по трафику)
ICE_TRANSPORT_POLICY=all

# ── Защита от ботов (необязательно): Cloudflare Turnstile ─────
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Модерация и лимиты ────────────────────────────────────────
SUPPORT_EMAIL=
# Сколько жалоб от РАЗНЫХ людей за 24 часа дают автоматический бан (0 — выключить)
AUTO_BAN_REPORT_THRESHOLD=3
AUTO_BAN_HOURS=24
# Сколько секунд×1000 ждать возвращения участника после обрыва связи
RECONNECT_GRACE_MS=10000
MAX_CONNECTIONS_PER_IP=20
SESSION_BURST_PER_IP=30
WS_CONNECT_BURST_PER_IP=30
REPORT_RETENTION_DAYS=90
BLOCK_RETENTION_DAYS=180

# Токен для /metrics (Prometheus). Пусто — эндпоинт выключен.
METRICS_TOKEN=

# Первый администратор создаётся при старте, если в базе ещё нет ни одного.
# После первого запуска эти строки лучше удалить.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# ── Только для docker-compose.prod.yml ────────────────────────
# Домен сайта (без https://) и публичный IP сервера для coturn
DOMAIN=
PUBLIC_IP=
