<?xml version="1.0" encoding="utf-8"?>
<!-- Только HTTPS: браузерный движок даёт доступ к камере лишь на защищённых страницах. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
