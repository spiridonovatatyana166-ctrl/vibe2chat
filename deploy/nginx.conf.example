# Альтернатива Caddy: Nginx перед приложением (сертификат — через certbot).
# TRUST_PROXY=1 в .env приложения.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl http2;
    server_name vibechat.example.com;

    ssl_certificate     /etc/letsencrypt/live/vibechat.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/vibechat.example.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Перезаписываем, а не дополняем — клиент не сможет подделать свой IP.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 120s;
    }
}

server {
    listen 80;
    server_name vibechat.example.com;
    return 301 https://$host$request_uri;
}
